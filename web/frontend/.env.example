# URL del backend (NestJS). No es un secreto: llega al navegador.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Medición de tráfico para el seguimiento de SEO. Si se deja vacío no se carga
# ningún script de analítica. Solo se activa cuando la persona acepta la
# categoría "analítica" en el aviso de cookies.
NEXT_PUBLIC_GA_ID=
